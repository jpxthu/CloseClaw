#!/bin/bash
set -e

staged_rs=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs')

if [ -n "$staged_rs" ]; then
    # 文件行数限制 — 仅检查 staged 文件，不背负历史技术债
    for f in $staged_rs; do
        lines=$(wc -l < "$f")
        if [ "$lines" -gt 1000 ]; then
            echo "ERROR: $f: ${lines} 行（上限 1000）"
            exit 1
        fi
    done

    # 环境变量禁令 — 禁止 set_var / remove_var（load_env_file 除外）
    # 判定与错误文案的单一来源：scripts/check-env-var.sh（与 CI 共享），细则见 docs/developer/STANDARDS.md §7
    bash scripts/check-env-var.sh staged

    # cargo fmt check — 仅检查 staged 文件，不背负历史技术债
    # 行宽（默认 100）、缩进、空白等格式问题一并覆盖
    if ! cargo fmt --check -- $staged_rs 2>&1; then
        echo "ERROR: 以上文件格式不符合规范，请运行 'cargo fmt' 修复后重新提交"
        exit 1
    fi
fi

# 角色检查 — 读取 git config hooks.role，加载对应的角色规则
hook_name=$(basename "$0")
role=$(git config hooks.role 2>/dev/null || true)
if [ -n "$role" ] && [ -f ".githooks/roles/${role}.${hook_name}" ]; then
    bash ".githooks/roles/${role}.${hook_name}"
fi

echo "All checks passed"
