{
  "protocol": "openai",
  "streaming": true,
  "scenario": "tool-use-streaming",
  "model": "fake-model",
  "expect": "tool_calls",
  "request": {
    "model": "fake-model",
    "messages": [
      {
        "role": "user",
        "content": "What's the weather in Tokyo?"
      }
    ],
    "stream": true,
    "stream_options": {
      "include_usage": true
    }
  },
  "tools_sent": [
    {
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Get the current weather for a location.",
        "parameters": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string",
              "description": "City name, e.g. Tokyo"
            }
          },
          "required": [
            "location"
          ]
        }
      }
    }
  ]
}